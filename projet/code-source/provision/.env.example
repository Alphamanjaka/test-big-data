# Template de configuration d'environnement — à copier en `.env` local.
#
# Les fichiers de clés d'environnement ne doivent JAMAIS être commités dans Git.
# Ce template liste les variables requises par le projet pour la configuration
# locale. Rappel : `.env` est dans `.gitignore`.

# ==============================================
# Configuration Base de Données (PostgreSQL)
# Ces valeurs sont lues depuis l'environnement et ne doivent pas apparaître en dur.
# ==============================================
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=votre_mot_de_passe_securise

# URL de connexion unique utilisée par l'API gouvernance
# (engine/governance/database.py → `connection_factory`).
# Base centrale du projet : `patient_plateform`.
# IMPORTANT : le mot de passe reste dans PGPASSWORD ; ne pas l'écrire ici.
DATABASE_URL=postgresql://postgres@localhost:5432/patient_plateform

# ==============================================
# Autres secrets potentiels (si ajoutés plus tard)
# ==============================================
NEXTAUTH_SECRET=GENERATE_A_RANDOM_64_HEX_VALUE
API_KEY=sk-remplacer_par_une_cle_de_demonstration
