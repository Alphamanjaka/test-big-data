# Copier ce fichier vers `projet/code-source/.env` (le vrai `.env` est gitignoré).
# Lu par `provision/db/rebuild_mmt_db.py`, `provision/db/rebuild_mavis_db.py`
# (et `DATABASE_URL` pour la connexion du moteur, cf. engine/governance/database.py).
# Ne jamais committer le fichier `.env`.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=<remplace par ton mot de passe local postgres>